# Lunziko AI Engine — configuration (autonome). Copier en .env.

# --- « Mémoire interne » : magasin local. Défaut ~/.lunziko/ai-engine ---
AI_ENGINE_HOME=

# --- Gateway ---
AE_HOST=0.0.0.0
AE_PORT=8770
AE_CORS_ORIGINS=http://localhost:3000
# Clés d'accès au gateway (CSV). Vide => accès libre en dev.
AE_API_KEYS=

# --- Persistance enfichable (indépendance) ---
# storage: sqlite (défaut, standalone) | postgres (couplage Platform, sans le modifier)
AE_STORAGE_BACKEND=sqlite
AE_VECTOR_BACKEND=local          # local | pgvector
AE_BLOB_BACKEND=fs               # fs | s3
AE_POSTGRES_DSN=                 # requis seulement si backend=postgres

# --- Provider Manager (clés PROPRES à l'AI Engine, jamais celles de Platform) ---
AE_DEFAULT_PROVIDER=claude
AE_PROVIDER_FALLBACK=claude,chatgpt,gemini,mistral,deepseek
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
# Serveur de modèle local optionnel (llama.cpp/vLLM/Ollama, API OpenAI-compat)
# --- OLLAMA (détecté sur ce PC) : décommenter pour tout faire tourner 100% local ---
# AE_LOCAL_BASE_URL=http://localhost:11434/v1
# AE_LOCAL_MODEL=qwen2.5:7b        # chat local par défaut (aussi dispo : glm4, deepseek-r1:7b, arc-llm-*)
# AE_DEFAULT_PROVIDER=local        # router le chat vers Ollama par défaut
# AE_EMBED_PROVIDER=local          # embeddings via Ollama (nomic-embed-text, dim 768)
# AE_EMBED_MODEL=nomic-embed-text
AE_LOCAL_BASE_URL=
AE_LOCAL_MODEL=
# Modèle code local pour /v1/code/* (privé, hors-ligne) : ex qwen2.5-coder | deepseek-coder-v2 | codellama
AE_CODE_MODEL=

# --- Embeddings / RAG ---
# auto (1er cloud dispo, sinon repli local hors-ligne) | openai | mistral | gemini | local | hash
AE_EMBED_PROVIDER=auto
AE_EMBED_MODEL=          # ex: text-embedding-3-small | mistral-embed | text-embedding-004 | nomic-embed-text
AE_EMBED_DIM=256         # dimension du repli local "hash" (offline, sans modèle)

# --- Mémoire chiffrée (AES-256-GCM) ---
# Clé base64 de 32 octets. Générer : python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# Vide => stockage en clair (mode dev uniquement). Requiert l'extra `secure` (cryptography).
AE_MEMORY_KEY=

# --- Écosystème (registre maître Lunziko : connaissance des applications) ---
# Chemin explicite du REGISTRE_ECOSYSTEME_LUNZIKO.md. Vide => découverte auto (racine Lunziko).
AE_REGISTRY_PATH=
# Synchroniser le registre dans le knowledge écosystème au démarrage (règle « analyse au lancement »).
AE_REGISTRY_AUTOSYNC=true

# --- LLM natif Lunziko (paquet lunziko-llm, 100% local, from scratch) ---
# Requiert `pip install -e ../lunziko-llm`. Vides => provider `lunziko` indisponible.
AE_LUNZIKO_LLM_CKPT=
AE_LUNZIKO_LLM_TOKENIZER=

# --- Code Execution Engine (A-11) ---
# Niveau 0 (safe-eval) toujours actif. Niveau 1 (sandbox subprocess) : n'activer QUE dans un
# environnement OS isolé (conteneur/firejail) pour du code non fiable.
AE_CODE_EXEC_ENABLED=false
AE_CODE_EXEC_TIMEOUT=10
AE_CODE_EXEC_MAX_OUTPUT=20000

# --- Search Engine web ---
# auto (Google si clé+cx sinon DuckDuckGo) | duckduckgo | google
AE_SEARCH_BACKEND=auto
# Google Custom Search (optionnel) : clé API + ID du moteur (CSE). Vides => DuckDuckGo sans clé.
AE_GOOGLE_API_KEY=
AE_GOOGLE_CSE_ID=

# --- Branchement Graphics Engine (dépôt séparé, API REST FastAPI) ---
# ex http://127.0.0.1:8000 (lancer côté moteur : python -m manager.cli serve).
# Vide => non branché (Brains image/vision/video/3d/cad restent « déclarés »).
AE_GRAPHICS_ENGINE_URL=
AE_GRAPHICS_ENGINE_API_KEY=

# --- Voix — MT (traduction V-3) ---
# auto = MADLAD-400 si extra `voice-mt` (transformers+sentencepiece) installé, sinon repli LLM.
AE_MT_BACKEND=auto
AE_MT_MODEL=google/madlad400-3b-mt

# --- Qwen 3.8-Max (Alibaba) — provider optionnel compatible OpenAI ---
# Activé uniquement si QWEN_API_KEY est renseignée.
QWEN_API_KEY=
AE_QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
AE_QWEN_MODEL=qwen3.8-max
